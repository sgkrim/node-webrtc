+// НАША НОВА РЕАЛІЗАЦІЯ
+cricket::ChannelInterface* PeerConnection::GetChannelByTrackId(const std::string& track_id) {
+  // Цей метод виконується всередині PeerConnection і має безпечний доступ до своїх даних
+  rtc::scoped_refptr<RtpTransceiverProxyWithInternal<RtpTransceiver>> found_transceiver;
+  for (const auto& transceiver : GetTransceivers()) {
+    if (transceiver->receiver() && transceiver->receiver()->track() &&
+        transceiver->receiver()->track()->id() == track_id) {
+      found_transceiver =
+          static_cast<RtpTransceiverProxyWithInternal<RtpTransceiver>*>(
+              transceiver.get());
+      break;
+    }
+  }
+
+  if (found_transceiver && found_transceiver->internal()->channel()) {
+    return found_transceiver->internal()->channel();
+  }
+
+  return nullptr;
+}
