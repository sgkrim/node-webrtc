+void BaseChannel::SetRawRtpPacketSink(webrtc::RtpPacketSinkInterface* sink) {
+  // Використовуємо Invoke, щоб безпечно встановити вказівник
+  // у тому ж потоці, де обробляються пакети (network_thread).
+  network_thread_->Invoke<void>(RTC_FROM_HERE, [this, sink] {
+    RTC_DCHECK_RUN_ON(network_thread_);
+    raw_rtp_packet_sink_ = sink;
+  });
+}
