+// Implementation of the new public method to get a voice channel.
+cricket::VoiceMediaChannel* ChannelManager::GetVoiceMediaChannel(
+    const std::string& transport_name) {
+  for (const auto& channel : voice_channels_) {
+    if (channel->transport_name() == transport_name) {
+      return channel.get();
+    }
+  }
+  return nullptr;
+}
+
+// Implementation of the new public method to get a video channel.
+cricket::VideoMediaChannel* ChannelManager::GetVideoMediaChannel(
+    const std::string& transport_name) {
+  for (const auto& channel : video_channels_) {
+    if (channel->transport_name() == transport_name) {
+      return channel.get();
+    }
+  }
+  return nullptr;
+}

